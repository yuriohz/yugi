{
  "manifest_version": 3,
  "name": "WriteRight — AI Proofreader",
  "version": "1.0.0",
  "description": "AI spelling and grammar suggestions across the web, powered by your OpenRouter key.",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/yuriohz/yugi",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "WriteRight settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
